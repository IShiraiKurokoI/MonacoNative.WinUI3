<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Shared read-only validation. Runs in MSBuild; no Python, PowerShell,
       LLVM build, DLL execution, or host-architecture probing is required. -->
  <UsingTask TaskName="MonacoNative.Build.MonacoNativeValidateBinary"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <Task>
      <Code Type="Class" Language="cs" Source="$(MSBuildThisFileDirectory)MonacoNative.NativeBinaryCheck.cs" />
    </Task>
  </UsingTask>
  <PropertyGroup>
    <!-- Kept in sync with native-abi.json / language ABI / ClangLanguageEngine.cpp
         by scripts/check-packaging-platforms.py. These are export presence checks,
         not proof of the functions' returned ABI versions or behavior. -->
    <_MonacoNativeCoreExports>mn_abi_version;mn_abi_get_info;mn_model_create;mn_model_destroy;mn_model_length;mn_model_line_count;mn_model_version_id;mn_model_can_undo;mn_model_can_redo;mn_model_undo;mn_model_redo;mn_model_set_undo_selections;mn_model_set_undo_after_selections;mn_model_copy_restored_selections;mn_model_begin_undo_transaction;mn_model_end_undo_transaction;mn_model_rollback_undo_transaction;mn_model_push_undo_stop;mn_model_in_undo_transaction;mn_model_set_text;mn_model_copy_text;mn_model_copy_text_range;mn_model_copy_line;mn_model_line_max_column;mn_model_replace;mn_model_replace_all;mn_model_set_language;mn_model_copy_language;mn_model_get_position_at;mn_model_get_offset_at;mn_model_get_eol;mn_model_set_eol;mn_model_find_matches;mn_model_get_word_range;mn_model_find_matches_in_lines;mn_model_find_matching_bracket;mn_tsf_create;mn_tsf_destroy;mn_tsf_focus_enter;mn_tsf_focus_leave;mn_tsf_notify_selection_changed;mn_tsf_set_read_only;mn_tsf_key_down;mn_tsf_key_up;mn_unicode_previous_grapheme_boundary;mn_unicode_next_grapheme_boundary;mn_unicode_previous_word_boundary;mn_unicode_next_word_boundary;mn_diff_compute;mn_diff_destroy;mn_diff_change_count;mn_diff_get_change;mn_diff_get_inner_change;mn_diff_move_count;mn_diff_get_move;mn_view_create;mn_view_destroy;mn_view_set_wrap_column;mn_view_set_wrap_width;mn_view_set_line_height;mn_view_set_measure_callback;mn_view_rebuild;mn_view_line_count;mn_view_copy_line;mn_view_get_line_info;mn_view_get_vertical_offset;mn_view_total_height;mn_view_line_at_vertical_offset;mn_view_model_to_view;mn_view_view_to_model;mn_view_set_hidden_areas;mn_view_add_view_zone;mn_view_remove_view_zone;mn_view_clear_view_zones;mn_view_add_injected_text;mn_view_remove_injected_text;mn_view_clear_injected_text;mn_view_scroll_top_to_reveal;mn_keybinding_create;mn_keybinding_destroy;mn_keybinding_set_context_bool;mn_keybinding_set_context_number;mn_keybinding_set_context_string;mn_keybinding_reset_context;mn_keybinding_context_matches;mn_keybinding_register;mn_keybinding_unregister;mn_keybinding_reset_chord;mn_keybinding_in_chord_mode;mn_keybinding_resolve;mn_keybinding_copy_resolved_command;mn_keybinding_copy_pending_chord;mn_keybinding_resolve_snapshot;mn_language_abi_version;mn_language_free;mn_cpp_create;mn_cpp_destroy;mn_cpp_request;mn_typescript_request</_MonacoNativeCoreExports>
    <_MonacoNativeClangExports>clang_createIndex;clang_disposeIndex;clang_parseTranslationUnit2;clang_reparseTranslationUnit;clang_defaultReparseOptions;clang_disposeTranslationUnit;clang_codeCompleteAt;clang_disposeCodeCompleteResults;clang_getNumCompletionChunks;clang_getCompletionChunkKind;clang_getCompletionChunkText;clang_getCompletionPriority;clang_getCompletionAvailability;clang_getCompletionBriefComment;clang_getCString;clang_disposeString;clang_getClangVersion;clang_getNumDiagnostics;clang_getDiagnostic;clang_getDiagnosticSeverity;clang_getDiagnosticSpelling;clang_getDiagnosticLocation;clang_getDiagnosticNumRanges;clang_getDiagnosticRange;clang_disposeDiagnostic;clang_getSpellingLocation;clang_getFileName;clang_getFile;clang_getLocationForOffset;clang_getRangeStart;clang_getRangeEnd;clang_getCursor;clang_getCursorReferenced;clang_getCursorDefinition;clang_Cursor_isNull;clang_getCursorSpelling;clang_getCursorDisplayName;clang_Cursor_getBriefCommentText;clang_getCursorType;clang_getTypeSpelling;clang_getCursorLocation;clang_getCursorExtent;clang_findReferencesInFile;clang_getNumArgTypes;clang_getArgType;clang_isFunctionTypeVariadic;clang_Cursor_getNumArguments;clang_Cursor_getArgument;clang_getCursorResultType;clang_getNumOverloadedDecls;clang_getOverloadedDecl</_MonacoNativeClangExports>
  </PropertyGroup>
</Project>
