<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- NuGet resolves relative paths from this config file's directory. -->
    <add key="MonacoNativeLocalPackages" value="../../artifacts/packages" />
    <add key="NuGetOrg" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
