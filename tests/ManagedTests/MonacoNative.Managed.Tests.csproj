<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\'))</RepoRoot>
    <NativeCoreDll>$(RepoRoot)artifacts\native\x64\$(Configuration)\MonacoNative.Core.Native.dll</NativeCoreDll>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\MonacoNative.Core.Managed\MonacoNative.Core.Managed.csproj" />
    <ProjectReference Include="..\..\src\MonacoNative.I18n\MonacoNative.I18n.csproj" />
    <ProjectReference Include="..\..\src\MonacoNative.Input\MonacoNative.Input.csproj" />
  </ItemGroup>
  <Target Name="CopyNativeCore" AfterTargets="Build">
    <Error Condition="!Exists('$(NativeCoreDll)')" Text="Native core DLL not found at $(NativeCoreDll). Build MonacoNative.Core.Native first." />
    <Copy SourceFiles="$(NativeCoreDll)" DestinationFolder="$(OutDir)" />
  </Target>
</Project>
