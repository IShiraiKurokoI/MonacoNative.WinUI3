<UserControl
    x:Class="MonacoNative.Renderer.WinUI3.MonacoDiffEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MonacoNative.Renderer.WinUI3"
    Loaded="DiffEditor_Loaded"
    SizeChanged="DiffEditor_SizeChanged">
    <Border x:Name="DiffRoot"
            BorderBrush="#3F3F46"
            BorderThickness="1"
            CornerRadius="4"
            Background="#1E1E1E">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#252526" Padding="8,6" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="OriginalHeader" Grid.Column="0" Foreground="#D4D4D4" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <Button x:Name="PreviousChangeButton" MinWidth="32" Padding="6,2" Content="↑" Click="PreviousChange_Click" />
                    <Button x:Name="NextChangeButton" MinWidth="32" Padding="6,2" Content="↓" Click="NextChange_Click" />
                    <Button x:Name="RevertCurrentButton" MinWidth="32" Padding="6,2" Content="↶" Click="RevertCurrent_Click" />
                    <ToggleButton x:Name="LayoutToggle" MinWidth="78" Padding="8,2" Click="LayoutToggle_Click" />
                    <CheckBox x:Name="HideUnchangedCheckBox" VerticalAlignment="Center"
                              Checked="HideUnchanged_Changed" Unchecked="HideUnchanged_Changed" />
                </StackPanel>
                <TextBlock x:Name="SummaryText" Grid.Column="2" Margin="8,0" Foreground="#BDBDBD" VerticalAlignment="Center" />
                <TextBlock x:Name="ModifiedHeader" Grid.Column="3" Foreground="#D4D4D4"
                           TextAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <Grid x:Name="SideBySideRoot" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <local:MonacoEditor x:Name="OriginalEditor" Grid.Column="0" />
                <Border Grid.Column="1" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1,0">
                    <Canvas x:Name="RevertGutter" />
                </Border>
                <local:MonacoEditor x:Name="ModifiedEditor" Grid.Column="2" />
            </Grid>

            <Grid x:Name="InlineRoot" Grid.Row="1" Visibility="Collapsed">
                <local:MonacoEditor x:Name="InlineEditor" />
                <Canvas x:Name="InlineDeletedOverlay" IsHitTestVisible="False" />
                <Canvas x:Name="InlineActionOverlay" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
