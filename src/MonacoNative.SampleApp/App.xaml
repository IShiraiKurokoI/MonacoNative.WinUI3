<Application
    x:Class="MonacoNative.SampleApp.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Merge WinUI 3 control templates/theme brushes before our application overrides.
                 Without this, controls such as DropDownButton can fail at startup with
                 "Cannot find a Resource with the Name/Key TabViewButtonBackground". -->
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F8F8F8" />
                    <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#F8F8F8" />
                    <SolidColorBrush x:Key="ToolbarBorderBrush" Color="#E5E5E5" />
                    <SolidColorBrush x:Key="ToolbarForegroundBrush" Color="#3B3B3B" />
                    <SolidColorBrush x:Key="StatusBackgroundBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="StatusBorderBrush" Color="#E5E5E5" />
                    <SolidColorBrush x:Key="StatusForegroundBrush" Color="#3B3B3B" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#181818" />
                    <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#181818" />
                    <SolidColorBrush x:Key="ToolbarBorderBrush" Color="#2B2B2B" />
                    <SolidColorBrush x:Key="ToolbarForegroundBrush" Color="#CCCCCC" />
                    <SolidColorBrush x:Key="StatusBackgroundBrush" Color="#181818" />
                    <SolidColorBrush x:Key="StatusBorderBrush" Color="#2B2B2B" />
                    <SolidColorBrush x:Key="StatusForegroundBrush" Color="#CCCCCC" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#181818" />
                    <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#181818" />
                    <SolidColorBrush x:Key="ToolbarBorderBrush" Color="#2B2B2B" />
                    <SolidColorBrush x:Key="ToolbarForegroundBrush" Color="#CCCCCC" />
                    <SolidColorBrush x:Key="StatusBackgroundBrush" Color="#181818" />
                    <SolidColorBrush x:Key="StatusBorderBrush" Color="#2B2B2B" />
                    <SolidColorBrush x:Key="StatusForegroundBrush" Color="#CCCCCC" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="ToolbarLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource ToolbarForegroundBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,2,0" />
            </Style>
            <Style x:Key="ToolbarComboBoxStyle" TargetType="ComboBox">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="MinWidth" Value="132" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="ToolbarButtonStyle" TargetType="AppBarButton">
                <Setter Property="Foreground" Value="{ThemeResource ToolbarForegroundBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
