<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>MonacoNative.SampleApp</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\'))</RepoRoot>
    <MonacoNativeValidateCore>true</MonacoNativeValidateCore>
    <MonacoNativeValidationDependsOn>CopyNativeCore</MonacoNativeValidationDependsOn>
    <NativeCoreDll>$(RepoRoot)artifacts\native\$(Platform)\$(Configuration)\MonacoNative.Core.Native.dll</NativeCoreDll>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <ProjectReference Include="..\MonacoNative.Core.Managed\MonacoNative.Core.Managed.csproj" />
    <ProjectReference Include="..\MonacoNative.EditorServices\MonacoNative.EditorServices.csproj" />
    <ProjectReference Include="..\MonacoNative.Renderer.WinUI3\MonacoNative.Renderer.WinUI3.csproj" />
    <ProjectReference Include="..\MonacoNative.Core.Native\MonacoNative.Core.Native.vcxproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <!-- demo.cs is compiled into this existing project so Roslyn can resolve .NET members. -->
    <Content Include="Assets\Samples\*.*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyNativeCore" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('$(NativeCoreDll)')" Text="Native core DLL not found at $(NativeCoreDll)." />
    <Copy SourceFiles="$(NativeCoreDll)" DestinationFolder="$(OutDir)" />
  </Target>
  <!-- Include the native DLL in publish output, not just the normal build folder. -->
  <Target Name="IncludeNativeCoreForPublish" AfterTargets="ComputeFilesToPublish"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('$(NativeCoreDll)')" Text="Native core DLL not found at $(NativeCoreDll). Build the selected platform before publishing with --no-build." />
    <ItemGroup>
      <ResolvedFileToPublish Include="$(NativeCoreDll)" RelativePath="MonacoNative.Core.Native.dll"
                             CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
  <Import Project="..\..\packaging\buildTransitive\MonacoNative.ClangRuntime.targets" />
</Project>
